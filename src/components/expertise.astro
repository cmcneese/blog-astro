---
---

<section class="text-[var(--white)] py-12 md:py-24">
  <div class="max-w-5xl mx-auto space-y-12">
    <div class="space-y-4 text-center md:text-left">
      <h2 class="text-4xl md:text-5xl font-medium">Core Competencies</h2>
      <p class="text-[var(--white-icon)] text-lg">
        Backend systems, data integration, and healthcare technology
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="group relative overflow-hidden rounded-xl border border-[#ffffff10] bg-[#1414149c] p-6 transition-all duration-300 hover:border-[var(--sec)] hover:bg-[#1a1a2e]">
        <div class="absolute inset-0 bg-gradient-to-br from-[var(--sec)]/10 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100" />
        <div class="relative space-y-3">
          <h3 class="text-xl font-semibold text-[var(--white)] group-hover:text-[var(--sec)] transition-colors">Backend Architecture</h3>
          <ul class="space-y-2 text-[var(--white-icon)] text-sm">
            <li>• REST API design and implementation</li>
            <li>• NestJS, Laravel, Node.js frameworks</li>
            <li>• Microservices and event-driven systems</li>
            <li>• Database design and optimization</li>
            <li>• Performance profiling and scaling</li>
          </ul>
        </div>
      </div>

      <div class="group relative overflow-hidden rounded-xl border border-[#ffffff10] bg-[#1414149c] p-6 transition-all duration-300 hover:border-[var(--sec)] hover:bg-[#1a1a2e]">
        <div class="absolute inset-0 bg-gradient-to-br from-[var(--sec)]/10 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100" />
        <div class="relative space-y-3">
          <h3 class="text-xl font-semibold text-[var(--white)] group-hover:text-[var(--sec)] transition-colors">Data Integration & Automation</h3>
          <ul class="space-y-2 text-[var(--white-icon)] text-sm">
            <li>• ETL pipeline design and implementation</li>
            <li>• Third-party API orchestration</li>
            <li>• Python scripting and automation</li>
            <li>• Data transformation and mapping</li>
            <li>• Integration testing and validation</li>
          </ul>
        </div>
      </div>

      <div class="group relative overflow-hidden rounded-xl border border-[#ffffff10] bg-[#1414149c] p-6 transition-all duration-300 hover:border-[var(--sec)] hover:bg-[#1a1a2e]">
        <div class="absolute inset-0 bg-gradient-to-br from-[var(--sec)]/10 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100" />
        <div class="relative space-y-3">
          <h3 class="text-xl font-semibold text-[var(--white)] group-hover:text-[var(--sec)] transition-colors">Healthcare Technology</h3>
          <ul class="space-y-2 text-[var(--white-icon)] text-sm">
            <li>• Claims processing workflows</li>
            <li>• Cost estimation and modeling</li>
            <li>• Revenue cycle systems</li>
            <li>• Payer/provider data integration</li>
            <li>• HIPAA-compliant architectures</li>
          </ul>
        </div>
      </div>

      <div class="group relative overflow-hidden rounded-xl border border-[#ffffff10] bg-[#1414149c] p-6 transition-all duration-300 hover:border-[var(--sec)] hover:bg-[#1a1a2e]">
        <div class="absolute inset-0 bg-gradient-to-br from-[var(--sec)]/10 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100" />
        <div class="relative space-y-3">
          <h3 class="text-xl font-semibold text-[var(--white)] group-hover:text-[var(--sec)] transition-colors">Content Management Systems</h3>
          <ul class="space-y-2 text-[var(--white-icon)] text-sm">
            <li>• Cascade CMS expertise</li>
            <li>• Apache Velocity template development</li>
            <li>• Programmatic content workflows</li>
            <li>• PHP backend integration</li>
            <li>• Enterprise CMS architecture</li>
          </ul>
        </div>
      </div>

      <div class="group relative overflow-hidden rounded-xl border border-[#ffffff10] bg-[#1414149c] p-6 transition-all duration-300 hover:border-[var(--sec)] hover:bg-[#1a1a2e]">
        <div class="absolute inset-0 bg-gradient-to-br from-[var(--sec)]/10 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100" />
        <div class="relative space-y-3">
          <h3 class="text-xl font-semibold text-[var(--white)] group-hover:text-[var(--sec)] transition-colors">Infrastructure & DevOps</h3>
          <ul class="space-y-2 text-[var(--white-icon)] text-sm">
            <li>• Docker containerization</li>
            <li>• CI/CD automation</li>
            <li>• Cloud infrastructure (AWS)</li>
            <li>• Deployment automation</li>
            <li>• System monitoring and reliability</li>
          </ul>
        </div>
      </div>

      <div class="group relative overflow-hidden rounded-xl border border-[#ffffff10] bg-[#1414149c] p-6 transition-all duration-300 hover:border-[var(--sec)] hover:bg-[#1a1a2e]">
        <div class="absolute inset-0 bg-gradient-to-br from-[var(--sec)]/10 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100" />
        <div class="relative space-y-3">
          <h3 class="text-xl font-semibold text-[var(--white)] group-hover:text-[var(--sec)] transition-colors">Full-Stack Development</h3>
          <ul class="space-y-2 text-[var(--white-icon)] text-sm">
            <li>• End-to-end application delivery</li>
            <li>• Frontend & backend integration</li>
            <li>• WordPress and Laravel applications</li>
            <li>• Developer experience optimization</li>
            <li>• Production support and scaling</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

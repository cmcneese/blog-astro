---
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<section class="text-[var(--white)] py-12 md:py-24" id="blog">
  <div class="max-w-5xl mx-auto space-y-12">
    <div class="space-y-4 text-center md:text-left">
      <h2 class="text-4xl md:text-5xl font-medium">Latest Articles</h2>
      <p class="text-[var(--white-icon)] text-lg">
        Thoughts on web development, system design, and building scalable software
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {sortedPosts.map((post) => (
        <article class="group relative overflow-hidden rounded-xl border border-[#ffffff10] bg-[#1414149c] p-6 transition-all duration-300 hover:border-[var(--sec)] hover:bg-[#1a1a2e]">
          <div class="absolute inset-0 bg-gradient-to-br from-[var(--sec)]/10 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100" />
          
          <div class="relative space-y-4">
            <div class="flex items-start justify-between gap-4">
              <div class="flex-1 space-y-2">
                <h3 class="text-xl font-semibold text-[var(--white)] group-hover:text-[var(--sec)] transition-colors">
                  {post.data.title}
                </h3>
                <p class="text-sm text-[var(--white-icon)]">
                  {post.data.pubDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                  })}
                </p>
              </div>
            </div>

            <p class="text-[var(--white-icon)] line-clamp-2">
              {post.data.description}
            </p>

            {post.data.tags && post.data.tags.length > 0 && (
              <div class="flex flex-wrap gap-2 pt-2">
                {post.data.tags.map((tag) => (
                  <span class="inline-block bg-[var(--sec)]/20 text-[var(--sec)] text-xs px-2 py-1 rounded">
                    {tag}
                  </span>
                ))}
              </div>
            )}

            <a 
              href={`/blog/${post.id.replace(/\.md$/, '')}`}
              class="inline-block mt-4 text-[var(--sec)] hover:text-white transition-colors font-medium"
            >
              Read More →
            </a>
          </div>
        </article>
      ))}
    </div>

    {sortedPosts.length === 0 && (
      <div class="text-center py-12">
        <p class="text-[var(--white-icon)]">No blog posts yet. Check back soon!</p>
      </div>
    )}
  </div>
</section>
